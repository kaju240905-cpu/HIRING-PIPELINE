generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  ARCHIVED
}

enum ActionType {
  CREATED
  STAGE_ADVANCED
  REJECTED
  REINSTATED
  FEEDBACK_ADDED
  ARCHIVED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NEUTRAL
  REJECT
  STRONG_REJECT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  
  assignedApplications InterviewerAssignment[]
  actionsPerformed     ApplicationHistory[]
  interviewsCreated    Interview[]             @relation("InterviewCreator")
  interviewsConducted  Interview[]             @relation("InterviewInterviewer")
  feedbacksSubmitted   Feedback[]              @relation("FeedbackInterviewer")
}

model JobOpening {
  id          String    @id @default(uuid())
  title       String
  department  String
  description String
  status      JobStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
}

model Application {
  id             String            @id @default(uuid())
  jobId          String
  job            JobOpening        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidateName  String
  candidateEmail String
  source         String
  notes          String?
  currentStage   ApplicationStage  @default(APPLIED)
  status         ApplicationStatus @default(ACTIVE)
  appliedAt      DateTime          @default(now())
  stageEnteredAt DateTime          @default(now())
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  history           ApplicationHistory[]
  assignments       InterviewerAssignment[]
  interviews        Interview[]
  stalledDismissals StalledAlertDismissal[]

  @@index([jobId])
  @@index([currentStage, status])
  @@index([appliedAt])
  @@index([updatedAt])
}

model InterviewerAssignment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewerId String
  interviewer   User        @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([applicationId, interviewerId])
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewerId String
  interviewer   User            @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  roundTitle    String?
  scheduledAt   DateTime
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  createdBy     String
  creator       User            @relation("InterviewCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  feedback      Feedback?

  @@index([applicationId])
  @@index([interviewerId])
  @@index([status])
}

model Feedback {
  id                        String         @id @default(uuid())
  interviewId               String         @unique
  interview                 Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId             String
  interviewer               User           @relation("FeedbackInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  technicalSkillsRating     Int
  communicationSkillsRating Int
  problemSolvingRating      Int
  roleSpecificSkillsRating  Int
  recommendation            Recommendation
  strengths                 String
  concerns                  String
  comments                  String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([interviewerId])
}

model ApplicationHistory {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actorId       String?
  actor         User?            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actionType    ActionType
  stage         ApplicationStage?
  oldStage      ApplicationStage?
  newStage      ApplicationStage?
  notes         String?
  createdAt     DateTime         @default(now())
}

model StalledAlertDismissal {
  id            String           @id @default(uuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  stage         ApplicationStage
  stageEnteredAt DateTime
  dismissedAt   DateTime         @default(now())

  @@unique([applicationId, stage, stageEnteredAt])
}
